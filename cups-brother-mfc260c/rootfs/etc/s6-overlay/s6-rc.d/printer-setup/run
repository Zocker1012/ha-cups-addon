# shellcheck shell=bash
# ==============================================================================
# Automatische Druckereinrichtung (nur Modus "printer_app" mit auto_setup)
# ==============================================================================

if [[ "$(bashio::config 'printer.mode')" != "printer_app" ]] || ! bashio::config.true 'printer.auto_setup'; then
    s6-svc -O .
    exit 0
fi

exec /etc/s6-overlay/scripts/printer-setup.sh
