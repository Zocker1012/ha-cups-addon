#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# nginx: Ingress-Proxy auf die Web-Oberfläche (CUPS oder Printer Application)
# ==============================================================================

# Sehr hohe fd-Limits (Docker-Default) begrenzen, falls möglich
ulimit -n 524288 2>/dev/null || true

bashio::log.info "Warte auf Web-Oberfläche (Port 631)..."
until (exec 3<>/dev/tcp/127.0.0.1/631) 2>/dev/null; do
    sleep 1
done

bashio::log.info "nginx-Ingress-Proxy wird gestartet"
exec nginx -g "daemon off;"
