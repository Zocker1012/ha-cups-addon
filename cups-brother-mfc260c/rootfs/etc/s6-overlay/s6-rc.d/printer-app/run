#!/command/with-contenv bashio
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 2026 Zocker1012
# shellcheck shell=bash
# ==============================================================================
# Legacy Printer Application (Modus "printer_app", CUPS-3-Weg)
# Stellt den Brother-PPD-Treiber als treiberlosen IPP-Everywhere-/AirPrint-
# Drucker bereit.
# ==============================================================================

if [[ "$(bashio::config 'printer.mode')" != "printer_app" ]]; then
    # Nicht aktiv: Dienst einmalig beenden, ohne Neustart durch s6
    s6-svc -O .
    exit 0
fi

# shellcheck source=printer-app-env.sh
source /etc/s6-overlay/scripts/printer-app-env.sh

# Sehr hohe fd-Limits (Docker-Default) begrenzen, falls möglich
ulimit -n 524288 2>/dev/null || true

mkdir -p "${SPOOL_DIR}" "${USER_PPD_DIR}"

# Alten Domain-Socket entfernen (die Auto-Einrichtung wartet auf den neuen)
rm -f /run/legacy-printer-app.sock

# ------------------------------------------------------------------------------
# Web-Admin-Passwort in die PAPPL-State-Datei schreiben
# (Format wie papplSystemHashPassword: "<nonce>~<sha256(nonce:passwort)>").
# ------------------------------------------------------------------------------
set_web_password() {
    local password nonce password_hash

    password=$(</run/cups-addon/web_password)
    nonce=$(openssl rand -hex 8)
    password_hash="${nonce}~$(printf '%s:%s' "${nonce}" "${password}" | sha256sum | cut -d' ' -f1)"

    if [[ -s "${STATE_FILE}" ]]; then
        sed -i '/^Password /d' "${STATE_FILE}"
        sed -i "1i Password ${password_hash}" "${STATE_FILE}"
    else
        printf 'DNSSDName %s\nPassword %s\n' "Brother MFC-260C" "${password_hash}" > "${STATE_FILE}"
    fi
}

set_web_password

# Bei "info" nur Warnungen der Printer Application: Sie schreibt sonst für jede
# einzelne Verbindung (Windows, Handys, HA-IPP-Integration ...) mehrere Zeilen.
# Alle Details gibt es mit log_level "debug".
case "$(bashio::config 'log_level')" in
    debug) log_level="debug" ;;
    info | warning) log_level="warn" ;;
    *) log_level="error" ;;
esac

# Auf Avahi warten, damit der Drucker sofort per DNS-SD angekündigt wird
for _ in $(seq 1 30); do
    [[ -e /run/avahi-daemon/socket ]] && break
    sleep 1
done

bashio::log.info "Legacy Printer Application wird gestartet (Port 631)"
exec legacy-printer-app server \
    -o server-port=631 \
    -o state-file="${STATE_FILE}" \
    -o log-file=- \
    -o log-level="${log_level}"
