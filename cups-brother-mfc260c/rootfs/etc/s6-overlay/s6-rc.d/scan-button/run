#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Scan-Menü am Gerät (Brother Scan-Key-Tool)
# Menü "Scan" am MFC-260C -> Scan landet im eingestellten Ordner
# ==============================================================================

readonly SKEY_DIR="/opt/brother/scanner/brscan-skey"
readonly SCRIPT="/usr/local/lib/cups-addon/scan-button.sh"

if [[ "$(</run/cups-addon/scanner_enabled)" != "true" ]] || ! bashio::config.true 'scan_menu.enabled'; then
    s6-svc -O .
    exit 0
fi

if [[ ! -e /usr/share/cups-addon-scan-button ]]; then
    bashio::log.warning "Scan-Menü: Brother Scan-Key-Tool (brscan-skey) fehlt im Image – siehe Dokumentation"
    s6-svc -O .
    exit 0
fi

# ------------------------------------------------------------------------------
# Alle Ziele des Scan-Menüs auf unser Skript lenken (Brothers eigene Skripte
# laufen dann nie). Das Tool nennt sie FILE, IMAGE, OCR und EMAIL – am Gerät
# heißen sie Datei, Bild, Text und E-Mail.
# Version 0.3.x: brscan-skey.config, Version 0.2.x: brscan-skey-<version>.cfg
# ------------------------------------------------------------------------------
configured=false
for cfg in "${SKEY_DIR}/brscan-skey.config" "${SKEY_DIR}"/brscan-skey-*.cfg; do
    [[ -f "${cfg}" ]] || continue
    for target in FILE IMAGE OCR EMAIL; do
        if grep -qE "^[[:space:]]*${target}[[:space:]]*=" "${cfg}"; then
            sed -i -E "s|^[[:space:]]*${target}[[:space:]]*=.*|${target}=\"bash ${SCRIPT} ${target,,}\"|" "${cfg}"
        else
            echo "${target}=\"bash ${SCRIPT} ${target,,}\"" >> "${cfg}"
        fi
    done
    bashio::log.info "Scan-Menü: ${cfg##*/} eingerichtet"
    bashio::log.debug "$(grep -E '^(FILE|IMAGE|OCR|EMAIL)=' "${cfg}")"
    configured=true
done

if [[ "${configured}" != "true" ]]; then
    bashio::log.error "Scan-Menü: Konfiguration von brscan-skey nicht gefunden"
    s6-svc -O .
    exit 0
fi

bashio::log.info "Scan-Menü am Gerät wird überwacht (Ziel: $(bashio::config 'scan_menu.folder'))"

# Version 0.3.x kann im Vordergrund laufen (-f) – ideal für s6
if [[ -x "${SKEY_DIR}/brscan-skey-exe" ]]; then
    exec "${SKEY_DIR}/brscan-skey-exe" -f
fi

# Version 0.2.x startet sich selbst im Hintergrund – solange er lebt, Dienst halten
skey=$(command -v brscan-skey || true)
if [[ -z "${skey}" ]]; then
    skey=$(find "${SKEY_DIR}" -maxdepth 1 -type f -name 'brscan-skey*' -perm -u+x ! -name '*.sh' | head -n1)
fi
if [[ -z "${skey}" ]]; then
    bashio::log.error "Scan-Menü: brscan-skey nicht gefunden"
    s6-svc -O .
    exit 0
fi

"${skey}" > /dev/null 2>&1 || true
sleep 3
while pgrep -f 'brscan-skey' > /dev/null; do
    sleep 30
done
bashio::log.warning "Scan-Menü: brscan-skey wurde beendet – starte neu"
exit 1
