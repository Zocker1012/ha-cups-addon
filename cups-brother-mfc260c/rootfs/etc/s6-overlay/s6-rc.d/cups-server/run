#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Klassischer CUPS-Server (Modus "cups")
# ==============================================================================

if [[ "$(bashio::config 'mode')" != "cups" ]]; then
    # Nicht aktiv: Dienst einmalig beenden, ohne Neustart durch s6
    s6-svc -O .
    exit 0
fi

# Sehr hohe fd-Limits (Docker-Default) begrenzen, falls möglich
ulimit -n 524288 2>/dev/null || true

# ------------------------------------------------------------------------------
# Auf Avahi-Socket warten
# ------------------------------------------------------------------------------
wait_for_avahi() {
    local timeout=30
    local elapsed=0

    bashio::log.info "Warte auf Avahi-Socket..."
    until [[ -e /run/avahi-daemon/socket ]]; do
        sleep 1
        elapsed=$((elapsed + 1))
        if [[ "${elapsed}" -ge "${timeout}" ]]; then
            bashio::log.warning "Avahi-Socket nach ${timeout}s nicht erreichbar – fahre ohne mDNS fort"
            return
        fi
    done
    bashio::log.info "Avahi-Socket bereit"
}

# ------------------------------------------------------------------------------
# CUPS-Konfiguration: Druckerdaten persistent in /data/cups,
# cupsd.conf/cups-files.conf bei jedem Start aus dem Image
# ------------------------------------------------------------------------------
prepare_cups_config() {
    local log_level

    if [[ ! -L /etc/cups ]]; then
        if [[ ! -e /data/cups/.initialized ]]; then
            bashio::log.info "Erststart: Lege CUPS-Konfiguration in /data/cups an"
            cp -a /etc/cups/. /data/cups/
            touch /data/cups/.initialized
        fi
        rm -rf /etc/cups
        ln -s /data/cups /etc/cups
    fi

    cp /usr/share/cups-addon/cupsd.conf /data/cups/cupsd.conf
    cp /usr/share/cups-addon/cups-files.conf /data/cups/cups-files.conf

    case "$(bashio::config 'log_level')" in
        debug) log_level="debug" ;;
        info) log_level="info" ;;
        warning) log_level="warn" ;;
        *) log_level="error" ;;
    esac
    sed -i "s/^LogLevel .*/LogLevel ${log_level}/" /data/cups/cupsd.conf
}

wait_for_avahi
prepare_cups_config

bashio::log.info "CUPS-Server wird gestartet"
exec cupsd -f
